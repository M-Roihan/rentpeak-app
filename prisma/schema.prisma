generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Tabel User (Induk dari Admin, Pegawai, Customer) ---
enum Role {
  CUSTOMER
  PEGAWAI
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  nama      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(100)
  NIK       String?  @unique @db.VarChar(20)
  password  String   @db.VarChar(255)
  peran     Role     @default(CUSTOMER)
  no_telp   String?  @db.VarChar(15)
  createdAt DateTime @default(now())

  // Relasi sesuai Class Diagram
  bookings        Booking[]
  jaminanDiproses Jaminan[]            @relation("PegawaiJaminan")
  laporanRusak    LaporanBarangRusak[]
  notifikasi      Notifikasi[]
}

// --- Tabel Barang ---
model Barang {
  id             String  @id @default(uuid())
  nama           String  @db.VarChar(100)
  kategori       String  @db.VarChar(50)
  harga_per_hari Decimal @db.Decimal(10, 2)
  stok_total     Int
  stok_tersedia  Int
  deskripsi      String? @db.Text
  kondisi        String  @db.VarChar(50)
  foto_url       String? @db.VarChar(255)

  // Relasi
  booking_details BookingDetail[]
  laporan_rusak   LaporanBarangRusak[]
}

// --- Tabel Booking (Transaksi Utama) ---
enum BookingStatus {
  MENUNGGU
  AKTIF
  SELESAI
  DIBATALKAN
}

model Booking {
  id              String        @id @default(uuid())
  customer_id     String
  customer        User          @relation(fields: [customer_id], references: [id])
  tanggal_booking DateTime      @default(now())
  tanggal_pinjam  DateTime      @db.Date
  tanggal_kembali DateTime      @db.Date
  total_biaya     Decimal       @db.Decimal(12, 2)
  status          BookingStatus @default(MENUNGGU)
  bukti_booking   String?       @db.VarChar(255)

  // Relasi
  details    BookingDetail[]
  pembayaran Pembayaran?
  jaminan    Jaminan?

  @@index([customer_id])
}

// --- Tabel Detail Booking (M-M antara Booking dan Barang) ---
model BookingDetail {
  id         String  @id @default(uuid())
  booking_id String
  booking    Booking @relation(fields: [booking_id], references: [id])
  barang_id  String
  barang     Barang  @relation(fields: [barang_id], references: [id])
  jumlah     Int
  subtotal   Decimal @db.Decimal(12, 2)

  @@index([booking_id])
  @@index([barang_id])
}

// --- Tabel Pembayaran ---
enum PaymentStatus {
  BERHASIL
  GAGAL
  PENDING
}

model Pembayaran {
  id                String        @id @default(uuid())
  booking_id        String        @unique
  booking           Booking       @relation(fields: [booking_id], references: [id])
  metode_pembayaran String        @db.VarChar(50)
  jumlah_bayar      Decimal       @db.Decimal(12, 2)
  tanggal_bayar     DateTime      @default(now())
  status            PaymentStatus @default(PENDING)

  @@index([booking_id])
}

// --- Tabel Jaminan (Diinput oleh Pegawai) ---
enum JaminanStatus {
  DISIMPAN
  DIKEMBALIKAN
}

model Jaminan {
  id            String        @id @default(uuid())
  booking_id    String        @unique
  booking       Booking       @relation(fields: [booking_id], references: [id])
  pegawai_id    String
  pegawai       User          @relation("PegawaiJaminan", fields: [pegawai_id], references: [id])
  foto_path     String        @db.VarChar(255)
  jenis_jaminan String        @db.VarChar(50)
  status        JaminanStatus @default(DISIMPAN)
  tanggal_input DateTime      @default(now())

  @@index([booking_id])
  @@index([pegawai_id])
}

// --- Tabel Laporan Barang Rusak (Dibuat oleh Pegawai) ---
enum PerbaikanStatus {
  DILAPORKAN
  DALAM_PERBAIKAN
  SELESAI
}

model LaporanBarangRusak {
  id               String          @id @default(uuid())
  barang_id        String
  barang           Barang          @relation(fields: [barang_id], references: [id])
  pegawai_id       String
  pegawai          User            @relation(fields: [pegawai_id], references: [id])
  deskripsi_rusak  String          @db.Text
  foto_bukti       String?         @db.VarChar(255)
  status_perbaikan PerbaikanStatus @default(DILAPORKAN)
  tanggal_laporan  DateTime        @default(now())

  @@index([barang_id])
  @@index([pegawai_id])
}

// --- Tabel Notifikasi ---
model Notifikasi {
  id           String   @id @default(uuid())
  user_id      String
  user         User     @relation(fields: [user_id], references: [id])
  pesan        String   @db.Text
  jenis        String   @db.VarChar(50)
  waktu        DateTime @default(now())
  sudah_dibaca Boolean  @default(false)

  @@index([user_id])
}
